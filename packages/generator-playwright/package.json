{
  "name": "@demohunter/generator-playwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@demohunter/manifest": "workspace:*",
    "@demohunter/media-ffmpeg": "workspace:*",
    "@demohunter/sdk": "workspace:*",
    "@demohunter/tts-core": "workspace:*",
    "@demohunter/tts-elevenlabs": "workspace:*",
    "@demohunter/tts-openai": "workspace:*",
    "playwright": ">=1.61"
  }
}
