{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "demohunter.studio"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "files": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "const": "project.json"
        },
        "events": {
          "type": "string",
          "const": "events.json"
        },
        "elements": {
          "type": "string",
          "const": "elements.json"
        },
        "edits": {
          "type": "string",
          "const": "edits.json"
        },
        "narration": {
          "type": "string",
          "const": "narration.json"
        },
        "comments": {
          "type": "string",
          "const": "comments.json"
        },
        "css": {
          "type": "string",
          "const": "overrides.css"
        }
      },
      "required": [
        "project",
        "events",
        "elements",
        "edits",
        "narration",
        "comments",
        "css"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "tour": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "tourSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["tour"],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "protocolVersion",
    "projectId",
    "captureId",
    "createdAt",
    "files"
  ],
  "additionalProperties": false
}
