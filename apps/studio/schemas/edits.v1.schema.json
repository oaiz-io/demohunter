              "src": {
                "type": "string",
                "minLength": 1
              },
              "startMs": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "minimum": 0
              },
              "offsetMs": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "default": 0.3,
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fadeInMs": {
                "default": 800,
                "type": "number",
                "minimum": 0
              },
              "fadeOutMs": {
                "default": 1500,
                "type": "number",
                "minimum": 0
