              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              },
              "rotate": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "easing": {
            "default": "ease-in-out",
            "type": "string",
            "enum": ["linear", "ease-in-out"]
          },
          "fill": {
            "default": "none",
            "type": "string",
            "enum": ["none", "forwards"]
          }
        },
        "required": ["id", "target", "startMs", "endMs", "from", "to"],
        "additionalProperties": false
