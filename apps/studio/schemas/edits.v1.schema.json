              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              },
              "rotate": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "to": {
            "type": "object",
