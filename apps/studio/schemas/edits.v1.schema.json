                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "startMs": {
            "type": "number",
            "minimum": 0
