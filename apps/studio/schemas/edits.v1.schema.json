        "sfx": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "atMs": {
                "type": "number",
                "minimum": 0
