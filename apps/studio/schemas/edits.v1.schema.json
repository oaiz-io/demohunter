{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clips": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "kind": {
                "type": "string",
                "const": "scene"
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "durationMs": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120000
              },
              "title": {
                "type": "string"
              }
            },
            "required": ["id", "kind", "src", "durationMs"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "kind": {
                "type": "string",
                "const": "recording"
              },
              "sourceStartMs": {
                "type": "number",
                "minimum": 0
              },
              "sourceEndMs": {
                "type": "number",
                "minimum": 0
              },
              "rate": {
                "default": 1,
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              },
              "holdMs": {
                "default": 0,
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["id", "sourceStartMs", "sourceEndMs"],
            "additionalProperties": false
          }
        ]
      }
    },
    "elements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "target": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "nodeId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "text": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "style": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["id", "target"],
        "additionalProperties": false
      }
    },
    "camera": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "target": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "nodeId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 4
          },
