          "y": {
            "type": "number"
          },
          "easeMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": ["id", "startMs", "endMs", "scale"],
        "additionalProperties": false
      }
    },
    "highlights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "target": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "nodeId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "color": {
            "default": "#a3e635",
            "type": "string"
          },
          "padding": {
            "default": 8,
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["id", "startMs", "endMs", "target"],
        "additionalProperties": false
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "target": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "nodeId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
