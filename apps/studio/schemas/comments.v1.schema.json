{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "elementRef": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "timeMs": {
            "type": "number",
            "minimum": 0
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved"]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "replies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "author": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": ["id", "body", "author", "createdAt"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "timeMs",
          "body",
          "author",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["threads"],
  "additionalProperties": false
}
