{
  "name": "demohunter-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build:internals": "bun x tsc -b tsconfig.json --pretty false",
    "build:cli": "bun run --cwd packages/cli build",
    "build": "bun run build:internals && bun run build:cli",
    "clean": "rm -rf packages/*/dist",
    "install:global": "bun run --cwd packages/cli link:global",
    "test:e2e": "bun test tests/e2e",
    "test:unit": "bun test packages",
    "verify": "bun run build && bun run typecheck:studio && bun run test",
    "desktop:package": "node apps/desktop/scripts/package.mjs",
    "typecheck": "bun x tsc -b tsconfig.json --pretty false && bun run --cwd packages/cli typecheck && bun run typecheck:studio",
    "test": "bun test",
    "uninstall:global": "bun run --cwd packages/cli unlink:global",
    "studio": "bun apps/studio/cli.ts",
    "test:studio": "bun test apps/studio",
    "typecheck:studio": "bun x tsc -p apps/studio/tsconfig.json",
    "desktop": "bun run --cwd apps/desktop start",
    "desktop:app": "bun run --cwd apps/desktop build && open \"apps/desktop/out/DemoHunter Studio.app\"",
    "test:desktop": "bun test apps/desktop"
  },
  "devDependencies": {
    "demohunter": "workspace:*",
    "@types/node": "25.6.0",
    "playwright": "1.61.0",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "electron"
  ]
}
